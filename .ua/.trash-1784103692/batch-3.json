  "nodes": [
    {
      "id": "file:ray_serve_cai/ray_service.py",
      "type": "file",
      "name": "ray_service.py",
      "filePath": "ray_serve_cai/ray_service.py",
      "summary": "RayService class wrapping all Ray cluster and Ray Serve operations — connecting to the cluster, deploying models via the engine registry, deleting and listing applications, and querying cluster resources.",
      "tags": ["service", "middleware", "singleton"],
      "complexity": "complex",
      "languageNotes": "deploy_model uses a ThreadPoolExecutor with a 30-second timeout so large model deployments return 'deploying' immediately rather than blocking the HTTP request."
    },
    {
      "id": "file:ray_serve_cai/engines/__init__.py",
      "type": "file",
      "name": "__init__.py",
      "filePath": "ray_serve_cai/engines/__init__.py",
      "summary": "Package initializer for the engines subpackage that imports and registers all built-in engine implementations (vLLM, MLflow) into the global engine registry on first import.",
      "tags": ["entry-point", "barrel", "factory"],
      "complexity": "moderate"
    },
    {
      "id": "file:ray_serve_cai/engines/registry.py",
      "type": "file",
      "name": "registry.py",
      "filePath": "ray_serve_cai/engines/registry.py",
      "summary": "Defines EngineRegistry — a singleton registry for LLM engine types — plus module-level get_registry() and register_engine() helpers used by engine modules and the management API to register and retrieve engine components.",
      "tags": ["service", "factory", "singleton"],
      "complexity": "complex"
    },
    {
      "id": "file:ray_serve_cai/engines/vllm_engine.py",
      "type": "file",
      "name": "vllm_engine.py",
      "filePath": "ray_serve_cai/engines/vllm_engine.py",
      "summary": "Implements VLLMEngine — a Ray Serve deployment class wrapping vLLM's AsyncLLMEngine for OpenAI-compatible chat and completion inference — along with create_vllm_deployment(), the factory function that builds a configured Ray Serve application with GPU/CPU placement, venv isolation, and autoscaling support.",
      "tags": ["service", "factory", "api-handler"],
      "complexity": "complex",
      "languageNotes": "Uses vLLM's internal OpenAIServingChat/Completion APIs directly; _RoutePathMiddleware strips the Ray Serve route prefix from ASGI scope so vLLM's internal routing still works."
    },
    {
      "id": "file:ray_serve_cai/engines/base_engine.py",
      "type": "file",
      "name": "base_engine.py",
      "filePath": "ray_serve_cai/engines/base_engine.py",
      "summary": "Abstract base class and interface definitions for LLM engine implementations, providing the contract that VLLMEngine and MLflowEngine must satisfy.",
      "tags": ["type-definition", "service", "middleware"],
      "complexity": "moderate"
    },
    {
