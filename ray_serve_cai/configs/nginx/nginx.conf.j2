# Nginx configuration for Ray Cluster Management
# Generated by start_nginx.py — do not edit directly.

worker_processes auto;
pid {{ run_dir }}/nginx.pid;
error_log {{ log_dir }}/nginx_error.log warn;

events {
    worker_connections {{ worker_connections }};
    use epoll;
    multi_accept on;
}

http {
    include {{ mime_types_path }};
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log {{ log_dir }}/nginx_access.log main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    client_max_body_size {{ client_max_body_size }};

    # Compression
    gzip on;
    gzip_vary on;
    gzip_types text/plain application/json application/javascript text/css
               text/xml application/xml application/x-javascript;

    include {{ conf_dir }}/conf.d/*.conf;
}
