# Nginx configuration for Ray Cluster Management
# Generated by start_nginx.py — do not edit directly.
# Customise via environment variables (see start_nginx.py :: build_context).

worker_processes {{ worker_processes }};
pid {{ run_dir }}/nginx.pid;
error_log {{ log_dir }}/nginx_error.log warn;

events {
    worker_connections {{ worker_connections }};
    use epoll;
    multi_accept on;
}

http {
    include {{ mime_types_path }};
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log {{ log_dir }}/nginx_access.log main;

    sendfile          on;
    tcp_nopush        {{ tcp_nopush }};
    tcp_nodelay       {{ tcp_nodelay }};
    keepalive_timeout {{ keepalive_timeout }};
    client_max_body_size {{ client_max_body_size }};


    include {{ conf_dir }}/conf.d/*.conf;
}
