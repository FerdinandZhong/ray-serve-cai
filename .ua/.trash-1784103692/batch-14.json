      "filePath": "ray_serve_cai/engines/yolo_engine.py",
      "summary": "Implements _YOLOBase — a Ray Serve batched deployment class that loads a YOLO model, runs batched image inference with Prometheus metrics, and returns detection results with bounding boxes, occlusion flags, and location codes — plus make_yolo_deployment() factory.",
      "tags": ["service", "factory", "api-handler"],
      "complexity": "complex",
      "languageNotes": "Uses Ray Serve's @serve.batch decorator for throughput optimization; exposes Prometheus Counter and Histogram metrics for requests, inference latency, batch size, and detection count."
    },
