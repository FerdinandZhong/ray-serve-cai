#!/usr/bin/env python3
"""
Ray Worker Node Launcher
Generated by launch_ray_cluster.py — do not edit directly.

{% if head_address %}
Head address (baked in at generation time): {{ head_address }}
{% else %}
Head address: read from RAY_HEAD_ADDRESS environment variable at runtime.
{% endif %}
Node type: {{ node_type }}  (registered as resource "node_type:{{ node_type }}")
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

VENV_PYTHON = Path("{{ venv_python }}")
RAY_BIN     = VENV_PYTHON.parent / "ray"   # /home/cdsw/.venv/bin/ray

if not VENV_PYTHON.exists():
    print(f"ERROR: venv not found at {VENV_PYTHON}")
    sys.exit(1)
if not RAY_BIN.exists():
    print(f"ERROR: ray binary not found at {RAY_BIN}")
    sys.exit(1)

print("=" * 70)
print("Ray Worker Node — startup")
print("=" * 70)

{% if head_address %}
HEAD_ADDRESS = "{{ head_address }}"
{% else %}
HEAD_ADDRESS = os.environ.get("RAY_HEAD_ADDRESS")
if not HEAD_ADDRESS:
    print("ERROR: RAY_HEAD_ADDRESS environment variable is not set")
    sys.exit(1)
{% endif %}

print(f"\nConnecting to head node: {HEAD_ADDRESS}")

# Brief wait so the head node has time to fully initialise its GCS
print("Waiting 30 s for head node to be ready...")
time.sleep(30)

# Register this node's type as a custom Ray resource label so that
# coordinator.py (_detect_node_type) and deployment scheduling strategies
# can identify and target specific node types without knowing node IDs.
NODE_TYPE = "{{ node_type }}"
node_resources = json.dumps({f"node_type:{NODE_TYPE}": 1})

cmd = [
    str(RAY_BIN),
    "start",
    "--address", HEAD_ADDRESS,
    "--resources", node_resources,
]
print(f"Node type label: node_type:{NODE_TYPE}")
print("Command:", " ".join(cmd))

# Retry up to 5 times — GCS may not accept connections immediately even
# after the management API health check passes.
MAX_RETRIES = 5
for attempt in range(1, MAX_RETRIES + 1):
    result = subprocess.run(cmd)
    if result.returncode == 0:
        break
    if attempt < MAX_RETRIES:
        wait = attempt * 15
        print(f"Attempt {attempt}/{MAX_RETRIES} failed (exit {result.returncode}). "
              f"Retrying in {wait}s...")
        time.sleep(wait)
    else:
        print(f"All {MAX_RETRIES} attempts failed. Exiting.")
        sys.exit(result.returncode)

print("\n✅ Joined Ray cluster")

# ── Start worker info server ──────────────────────────────────────────────────
# CML requires a live process on CDSW_APP_PORT to keep the application in
# "running" state. This server also exposes node metadata so the Management
# API can retrieve the worker's IP address and resources without querying GCS.
_app_port = int(os.environ.get("CDSW_APP_PORT", 8100))
print(f"\nStarting worker info server on port {_app_port} ...")
print(f"  node_type  : {NODE_TYPE}")
print(f"  head_address: {HEAD_ADDRESS}")

_server_env = {
    **os.environ,
    "PYTHONPATH":            str(Path("{{ project_dir }}")),
    "RAY_WORKER_NODE_TYPE":  NODE_TYPE,
    "RAY_HEAD_ADDRESS":      HEAD_ADDRESS,
    "RAY_WORKER_CPUS":       str(os.environ.get("WORKER_CPUS", "")),
    "RAY_WORKER_MEMORY_GB":  str(os.environ.get("WORKER_MEMORY_GB", "")),
    "RAY_WORKER_GPUS":       str(os.environ.get("WORKER_GPUS", "0")),
    "CDSW_APP_PORT":         str(_app_port),
}

# This call blocks until the server exits, keeping the CML application alive.
_server = subprocess.run(
    [str(VENV_PYTHON), "-m", "ray_serve_cai.worker_app"],
    env=_server_env,
)
sys.exit(_server.returncode)
