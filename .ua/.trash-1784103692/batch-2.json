      "id": "file:ray_serve_cai/management/api/engines.py",
      "type": "file",
      "name": "engines.py",
      "filePath": "ray_serve_cai/management/api/engines.py",
      "summary": "FastAPI router that provides endpoints for dynamically registering new LLM engine types at runtime via importlib and listing all registered engines with their default, using an engine registry pattern.",
      "tags": ["api-handler", "service", "factory"],
      "complexity": "moderate",
      "languageNotes": "Uses importlib.import_module for dynamic loading of engine modules at registration time, with whitelist path validation."
    },
    {
      "id": "file:ray_serve_cai/management/api/environments.py",
      "type": "file",
      "name": "environments.py",
      "filePath": "ray_serve_cai/management/api/environments.py",
      "summary": "FastAPI router managing Python virtual environment lifecycle — listing, inspecting, and creating venvs for LLM engine isolation — with async background creation tracked via an in-memory registry.",
      "tags": ["api-handler", "service", "middleware"],
      "complexity": "complex",
      "languageNotes": "Venv creation runs in a background threading.Thread to avoid blocking the request; status is tracked in a module-level _CREATIONS dict."
    },
    {
