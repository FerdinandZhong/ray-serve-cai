#!/usr/bin/env python3
"""
Ray Head Node Launcher
Generated by launch_ray_cluster.py — do not edit directly.

Configuration:
  Ray GCS port      : {{ ray_port }}
  Ray Dashboard port: {{ dashboard_port }}
  Management API    : {{ mgmt_cpu }} CPU, {{ mgmt_memory_gb }} GB RAM (pinned to this node)

Full startup sequence:
  [0/4] Ensure nginx installed    run setup_environment.py if missing
  [1/4] ray start --head          GCS :{{ ray_port }}, dashboard 127.0.0.1:{{ dashboard_port }}
  [2/4] Wait for GCS              poll 127.0.0.1:{{ ray_port }}
  [3/4] Deploy Management API     subprocess → deploy_ray_app.py (venv Python)
  [4/4] Start nginx               subprocess → start_nginx.py (venv Python)

This process stays alive after startup so the CAI application remains running.
This script only uses the stdlib — Ray is invoked via subprocesses so there
is no dependency on which Python interpreter runs this launcher.
"""
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

VENV_PYTHON = Path("{{ venv_python }}")
RAY_BIN     = VENV_PYTHON.parent / "ray"   # /home/cdsw/.venv/bin/ray
PROJECT_DIR = Path("{{ project_dir }}")

if not VENV_PYTHON.exists():
    print(f"ERROR: venv not found at {VENV_PYTHON}")
    sys.exit(1)
if not RAY_BIN.exists():
    print(f"ERROR: ray binary not found at {RAY_BIN}")
    sys.exit(1)

print("=" * 70)
print("Ray Head Node — startup")
print("=" * 70)

# ── Venv bin prepended to PATH ────────────────────────────────────────────────
# Running `.venv/bin/python` directly does NOT activate the venv — the venv's
# bin/ directory is NOT added to PATH automatically.  Prepend it now so that
# all child processes (raylet → Ray actor → vLLM EngineCore → FlashInfer JIT)
# can resolve binaries installed in the venv (e.g. ninja, ray, uvicorn).
_venv_bin = str(VENV_PYTHON.parent)
_path = os.environ.get("PATH", "")
if _venv_bin not in _path.split(":"):
    os.environ["PATH"] = _venv_bin + ":" + _path
    print(f"Prepended venv bin to PATH: {_venv_bin}")

# ── [0/4] Ensure nginx is installed ──────────────────────────────────────────
_nginx_bin = Path("/home/cdsw/.local/bin/nginx")
if not _nginx_bin.exists():
    print("\n[0/4] nginx not found — running setup_environment.py ...")
    _setup_script = PROJECT_DIR / "cai_integration" / "setup_environment.py"
    if not _setup_script.exists():
        print(f"ERROR: setup script not found: {_setup_script}")
        sys.exit(1)
    _r = subprocess.run(
        [str(VENV_PYTHON), str(_setup_script)],
        env={**os.environ, "PYTHONPATH": str(PROJECT_DIR)},
    )
    if _r.returncode != 0:
        print(f"ERROR: setup_environment.py failed (exit {_r.returncode})")
        sys.exit(_r.returncode)
    if not _nginx_bin.exists():
        print("ERROR: nginx still not found after setup_environment.py")
        sys.exit(1)
    print("  nginx installed successfully")

# ── Write GCS address file ────────────────────────────────────────────────────
# CDSW_IP_ADDRESS is the pod's internal IP set by CML.  Workers must connect
# to this IP on the GCS port — the public CAI domain only exposes port 443.
_pod_ip = os.environ.get("CDSW_IP_ADDRESS", "127.0.0.1")
_gcs_address = f"{_pod_ip}:{{ ray_port }}"
_gcs_file = PROJECT_DIR / "ray_gcs_address"
_gcs_file.write_text(_gcs_address)
print(f"GCS address     : {_gcs_address}  (written to {_gcs_file})")

# ── Monitoring (Ray Dashboard metrics tab) ────────────────────────────────────
# Set before ray start so the dashboard process inherits these env vars.
{% if prometheus_host %}os.environ["RAY_PROMETHEUS_HOST"] = "{{ prometheus_host }}"
{% endif %}{% if grafana_host %}os.environ["RAY_GRAFANA_HOST"] = "{{ grafana_host }}"
{% endif %}{% if grafana_iframe_host %}os.environ["RAY_GRAFANA_IFRAME_HOST"] = "{{ grafana_iframe_host }}"
{% endif %}{% if grafana_org_id %}os.environ["RAY_GRAFANA_ORG_ID"] = "{{ grafana_org_id }}"
{% endif %}
# ── [1/4] Start Ray head ─────────────────────────────────────────────────────
print("\n[1/4] Starting Ray head node...")
result = subprocess.run(
    [
        str(RAY_BIN),
        "start", "--head",
        "--port", "{{ ray_port }}",
        "--dashboard-host", "127.0.0.1",
        "--dashboard-port", "{{ dashboard_port }}",
        "--include-dashboard", "true",
        "--metrics-export-port", "{{ metrics_port }}",
        # Kill idle worker processes after 60 s instead of the default
        # (several minutes).  This directly reduces the ray::IDLE actor count
        # visible in the dashboard between bursts of work.
        "--system-config",
        '{"idle_worker_killing_time_threshold_ms": 60000}',
    ],
    capture_output=True,
    text=True,
)
if result.returncode != 0:
    print(f"ERROR: ray start --head failed (exit {result.returncode}):")
    print(result.stderr)
    sys.exit(result.returncode)
print("  Ray head started  (GCS :{{ ray_port }}, dashboard 127.0.0.1:{{ dashboard_port }}, metrics :{{ metrics_port }})")


# ── [2/4] Wait for GCS ───────────────────────────────────────────────────────
print("\n[2/4] Waiting for Ray GCS on 127.0.0.1:{{ ray_port }} ...")
for attempt in range(30):
    try:
        with socket.create_connection(("127.0.0.1", {{ ray_port }}), timeout=2):
            print(f"  GCS ready (attempt {attempt + 1})")
            break
    except OSError:
        time.sleep(2)
else:
    print("ERROR: GCS did not become ready within 60 s")
    sys.exit(1)


# ── [3/4] Deploy Management API ──────────────────────────────────────────────
print("\n[3/4] Deploying Management API via Ray Serve...")
print("  Resources: {{ mgmt_cpu }} CPU, {{ mgmt_memory_gb }} GB RAM (pinned to head node)")

deploy_script = PROJECT_DIR / "ray_serve_cai" / "scripts" / "deploy_ray_app.py"
if not deploy_script.exists():
    print(f"ERROR: deploy script not found: {deploy_script}")
    sys.exit(1)

# Ray Serve proxy tuning — set only the values that were explicitly configured;
# absent values fall through to Ray's built-in defaults.
_serve_env = {**os.environ, "PYTHONPATH": str(PROJECT_DIR)}
{% if proxy_health_check_period_s is not none %}_serve_env["RAY_SERVE_PROXY_HEALTH_CHECK_PERIOD_S"]  = "{{ proxy_health_check_period_s }}"
{% endif %}{% if proxy_health_check_timeout_s is not none %}_serve_env["RAY_SERVE_PROXY_HEALTH_CHECK_TIMEOUT_S"] = "{{ proxy_health_check_timeout_s }}"
{% endif %}{% if proxy_ready_check_timeout_s is not none %}_serve_env["RAY_SERVE_PROXY_READY_CHECK_TIMEOUT_S"]  = "{{ proxy_ready_check_timeout_s }}"
{% endif %}{% if proxy_min_draining_period_s is not none %}_serve_env["RAY_SERVE_PROXY_MIN_DRAINING_PERIOD_S"]  = "{{ proxy_min_draining_period_s }}"
{% endif %}
result = subprocess.run(
    [
        str(VENV_PYTHON),
        str(deploy_script),
        "--app-import",   "ray_serve_cai.management.app:app",
        "--name",         "management-api",
        "--route-prefix", "/",
        "--num-cpus",     "{{ mgmt_cpu }}",
        "--memory-gb",    "{{ mgmt_memory_gb }}",
        "--serve-port",   "5000",
        "--pin-to-head",
    ],
    env=_serve_env,
)
if result.returncode != 0:
    print(f"ERROR: Management API deployment failed (exit {result.returncode})")
    sys.exit(result.returncode)
print("  Management API live at http://127.0.0.1:5000/api/*")


# ── [4/4] Start nginx (foreground — keeps this application alive) ─────────────
print("\n[4/4] Starting nginx reverse proxy (foreground)...")
nginx_script = PROJECT_DIR / "ray_serve_cai" / "scripts" / "start_nginx.py"
if not nginx_script.exists():
    print(f"ERROR: nginx startup script not found: {nginx_script}")
    sys.exit(1)

app_port = int(os.environ.get("CDSW_APP_PORT", 8080))
print("\n" + "=" * 70)
print("Ray Head Node — all services running")
print("=" * 70)
print(f"  External  : :{app_port}  (nginx, public)")
print(f"  API       : http://127.0.0.1:5000/api/*  (Ray Serve, internal)")
print(f"  Dashboard : http://127.0.0.1:{{ dashboard_port }}/  (internal)")
print(f"  GCS       : 127.0.0.1:{{ ray_port }}  (internal)")
print("\nHanding off to nginx — application stays alive as long as nginx runs.")
print("=" * 70)

# exec into nginx via start_nginx.py --foreground; this call blocks until nginx exits.
result = subprocess.run(
    [str(VENV_PYTHON), str(nginx_script), "--foreground"],
    env={**os.environ, "PYTHONPATH": str(PROJECT_DIR)},
)
# If we reach here nginx has exited — propagate its exit code.
sys.exit(result.returncode)
