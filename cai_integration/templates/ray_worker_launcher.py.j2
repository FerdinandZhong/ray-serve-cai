#!/usr/bin/env python3
"""
Ray Worker Node Launcher
Generated by launch_ray_cluster.py — do not edit directly.

{% if head_address %}
Head address (baked in at generation time): {{ head_address }}
{% else %}
Head address: read from RAY_HEAD_ADDRESS environment variable at runtime.
{% endif %}
"""
import os
import subprocess
import sys
import time
from pathlib import Path

VENV_PYTHON = Path("{{ venv_python }}")

if not VENV_PYTHON.exists():
    print(f"ERROR: venv not found at {VENV_PYTHON}")
    sys.exit(1)

print("=" * 70)
print("Ray Worker Node — startup")
print("=" * 70)

{% if head_address %}
HEAD_ADDRESS = "{{ head_address }}"
{% else %}
HEAD_ADDRESS = os.environ.get("RAY_HEAD_ADDRESS")
if not HEAD_ADDRESS:
    print("ERROR: RAY_HEAD_ADDRESS environment variable is not set")
    sys.exit(1)
{% endif %}

print(f"\nConnecting to head node: {HEAD_ADDRESS}")

# Brief wait so the head node has time to fully initialise its GCS
print("Waiting 10 s for head node to be ready...")
time.sleep(10)

cmd = [
    str(VENV_PYTHON), "-m", "ray.scripts.ray_start",
    "--address", HEAD_ADDRESS,
]
print("Command:", " ".join(cmd))

result = subprocess.run(cmd)
sys.exit(result.returncode)
